{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pattern-map.local/schema/six-families-v16.json",
  "title": "Pattern Map v16 six-family specification",
  "type": "object",
  "required": [
    "schema_version",
    "framework_id",
    "status",
    "description",
    "public_map",
    "families",
    "invariants",
    "implementation_note"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "pattern-map.six-families.v16"
    },
    "framework_id": {
      "const": "pattern-map-discrimination-layer-v16"
    },
    "status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "public_map": {
      "const": true
    },
    "families": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "reader_question",
          "purpose",
          "mechanism",
          "inputs",
          "observable_actions",
          "outputs",
          "dependencies",
          "failure_modes",
          "boundaries",
          "implementation_levels",
          "when_not_to_use"
        ],
        "properties": {
          "id": {
            "enum": ["F1", "F2", "F3", "F4", "F5", "F6"]
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reader_question": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "observable_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "boundaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "implementation_levels": {
            "type": "object",
            "required": ["lightweight", "moderate", "advanced"],
            "properties": {
              "lightweight": {
                "type": "string"
              },
              "moderate": {
                "type": "string"
              },
              "advanced": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "when_not_to_use": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "implementation_note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
