{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/origin-accounting/run-record.schema.json",
  "title": "Origin-accounting run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "prompt_instance_id", "bundle_id", "condition", "model_id", "model_revision", "tokenizer_revision", "decoder", "chat_template", "runtime", "dependency_hashes", "hardware", "seed", "started_at_utc", "status", "input_tokens", "input_byte_length", "output_tokens", "latency_ms", "cpu_ms", "gpu_ms", "peak_memory_mb", "system_prompt_sha256", "user_prompt_sha256", "final_input_sha256", "raw_output_sha256", "error_code"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^RN-[A-Z2-7]{10}$"},
    "prompt_instance_id": {"type": "string", "pattern": "^PI-[A-Z2-7]{10}$"},
    "bundle_id": {"type": "string", "pattern": "^BD-[A-Z2-7]{10}$"},
    "condition": {"enum": ["F0", "F1", "F2"]},
    "model_id": {"type": "string"},
    "model_revision": {"type": ["string", "null"]},
    "tokenizer_revision": {"type": ["string", "null"]},
    "decoder": {"type": "object"},
    "chat_template": {"type": "string"},
    "runtime": {"type": "object"},
    "dependency_hashes": {"type": "object"},
    "hardware": {"type": "object"},
    "seed": {"type": ["integer", "string", "object", "null"]},
    "started_at_utc": {"type": "string"},
    "status": {"enum": ["completed", "runtime_error", "timeout", "cancelled"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "input_byte_length": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "latency_ms": {"type": "number", "minimum": 0},
    "cpu_ms": {"type": ["number", "null"], "minimum": 0},
    "gpu_ms": {"type": ["number", "null"], "minimum": 0},
    "peak_memory_mb": {"type": ["number", "null"], "minimum": 0},
    "system_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "user_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "final_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "error_code": {"enum": ["TIMEOUT", "CANCELLED", "BACKEND_ERROR", "EMPTY_OUTPUT", "INVALID_UTF8", "INVALID_JSON", "DUPLICATE_KEY", "SCHEMA_ERROR", "SEMANTIC_ERROR", "UNKNOWN_EVIDENCE_ID", "NONE"]}
  }
}
